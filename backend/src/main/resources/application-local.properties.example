# Copy to application-local.properties (gitignored) or set GEMINI_API_KEY in your environment.
# Environment variables override values in this file.

GEMINI_API_KEY=your-google-ai-studio-key-here
AI_ENABLED=true
AI_CRON_ENABLED=true

spring.ai.google.genai.api-key=${GEMINI_API_KEY}
spring.ai.google.genai.chat.options.model=gemini-2.5-flash
app.ai.enabled=${AI_ENABLED:true}
app.ai.cron.enabled=${AI_CRON_ENABLED:true}
