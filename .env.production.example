# Copy to .env.production on your production server (never commit the real file).
# Used by: docker compose -f compose.prod.yaml --env-file .env.production up -d

# Public URL users open in the browser (must match your DNS + TLS setup).
APP_AUTH_FRONTEND_URL=https://app.example.com

# Host port bound locally for your reverse proxy (Caddy/Traefik/nginx).
FRONTEND_PORT=3000

# Image tag pushed by CI (usually "latest" on master).
IMAGE_TAG=latest
GITHUB_REPOSITORY_OWNER=hinnisiemsen

# Database
POSTGRES_DB=fiscalnorth
POSTGRES_USER=fiscalnorth
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# RabbitMQ
RABBITMQ_USER=fiscalnorth
RABBITMQ_PASSWORD=change-me-to-a-long-random-password

# Google OAuth (redirect URI: https://<your-domain>/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI features
GEMINI_API_KEY=
AI_ENABLED=true
