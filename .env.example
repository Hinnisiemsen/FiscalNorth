# Copy to .env in the project root for `docker compose up` (optional).
# Values are passed to the backend service; never commit real secrets.

GEMINI_API_KEY=
AI_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe billing (optional — see docs/BILLING.md)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_TRIAL_DAYS=14
STRIPE_PAST_DUE_GRACE_DAYS=3
